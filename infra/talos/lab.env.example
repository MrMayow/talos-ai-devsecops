# Скопируйте этот файл в lab.env и замените значения на свои.

# Имя учебного кластера.
CLUSTER_NAME=ai-devsecops-lab

# IP-адрес Talos VM, показанный на консоли после загрузки с ISO.
TALOS_IP=192.168.1.50

# IP-адрес компьютера Windows 11, на котором работает Ollama.
WINDOWS_IP=192.168.1.10

# Версия Talos Linux. talosctl должен быть той же версии.
TALOS_VERSION=v1.13.6

# Диск внутри Talos VM. ОБЯЗАТЕЛЬНО проверьте командой talosctl get disks.
INSTALL_DISK=/dev/sda

# Полная строка installer image из Talos Image Factory.
# Пример:
# factory.talos.dev/vmware-installer/abcdef0123456789...:v1.13.6
INSTALLER_IMAGE=PASTE_IMAGE_FACTORY_INSTALLER_HERE

# Внешние порты NodePort.
GITEA_NODEPORT=30080

# Зафиксированный релиз Sim для воспроизводимой установки.
SIM_VERSION=v0.7.29

# Проверьте имена после установки: kubectl -n simstudio get deployments.
SIM_APP_DEPLOYMENT=sim-app
SIM_REALTIME_DEPLOYMENT=sim-realtime

# Совместимость со старым SIM, блокирующим private Gitea URL. См. docs/security.md.
ENABLE_GITEA_LOOPBACK_PROXY=false

# Разметка 300-гигабайтного диска Talos.
# EPHEMERAL хранит образы контейнеров, etcd и логи.
EPHEMERAL_MAX_SIZE=90GiB

# Отдельный постоянный том для PVC Gitea, runner и Sim.
LOCAL_STORAGE_MIN_SIZE=150GiB
LOCAL_STORAGE_MAX_SIZE=170GiB
