FROM qwen2.5:14b-instruct

# Requirements/review prompts are structured and deliberately compact.
# Capping the context prevents Ollama from reserving the model's full context
# on a 16 GB GPU, which caused multi-minute cold starts during verification.
PARAMETER num_ctx 30720
PARAMETER temperature 0.1
PARAMETER top_p 0.8
PARAMETER repeat_penalty 1.05
