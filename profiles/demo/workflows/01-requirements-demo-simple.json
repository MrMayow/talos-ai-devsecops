      "4769fc6e-3496-4e99-8305-a7e0f18be7de": {
        "id": "4769fc6e-3496-4e99-8305-a7e0f18be7de",
        "type": "function",
        "name": "Validate Requirements",
        "position": {
          "x": 2230,
          "y": 80
        },
        "subBlocks": {
          "code": {
            "id": "code",
            "type": "code",
            "value": "const requirements = {\n  summary: String(<requirementsanalyst.summary> ?? '').trim(),\n  functional_requirements: Array.isArray(<requirementsanalyst.functional_requirements>) ? <requirementsanalyst.functional_requirements> : [],\n  constraints: Array.isArray(<requirementsanalyst.constraints>) ? <requirementsanalyst.constraints> : [],\n  documentation_requirements: Array.isArray(<requirementsanalyst.documentation_requirements>) ? <requirementsanalyst.documentation_requirements> : [],\n  test_scenarios: Array.isArray(<requirementsanalyst.test_scenarios>) ? <requirementsanalyst.test_scenarios> : [],\n  open_questions: Array.isArray(<requirementsanalyst.open_questions>) ? <requirementsanalyst.open_questions> : []\n};\nconst errors = [];\nif (requirements.summary.length < 20) errors.push('Нет содержательного summary');\nif (requirements.functional_requirements.length < 1) errors.push('Нет функциональных требований');\nif (requirements.test_scenarios.length < 1) errors.push('Нет тестовых сценариев');\nconst requiredDocs=['docs/USER_GUIDE.md','docs/ADMIN_GUIDE.md','docs/TECHNICAL_GUIDE.md'];\nconst docs=new Map();\nfor(const item of requirements.documentation_requirements){const path=String(item?.path??'').trim();if(docs.has(path.toLowerCase()))errors.push(`Дубликат требования к документу: ${path}`);docs.set(path.toLowerCase(),item);if(String(item?.content??'').trim().length<40)errors.push(`Не описано содержание документа: ${path}`);if(String(item?.acceptance??'').trim().length<40)errors.push(`Нет проверяемой приёмки документа: ${path}`);}\nfor(const path of requiredDocs)if(!docs.has(path.toLowerCase()))errors.push(`Нет требования к обязательному документу: ${path}`);\nif(requirements.documentation_requirements.length!==requiredDocs.length)errors.push('Нужно ровно три требования к документации');\nreturn {valid: errors.length === 0, errors, requirements, context: <initializerequest.result>};\n"
          },
          "language": {
            "id": "language",
            "type": "dropdown",
            "value": "javascript"
          }
        },
