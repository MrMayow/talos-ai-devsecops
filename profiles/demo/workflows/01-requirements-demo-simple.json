      "bc1e9cf4-1a02-43d7-a0f3-a58ef60a11eb": {
        "id": "bc1e9cf4-1a02-43d7-a0f3-a58ef60a11eb",
        "type": "function",
        "name": "Initialize Request",
        "position": {
          "x": 510,
          "y": 80
        },
        "subBlocks": {
          "code": {
            "id": "code",
            "type": "code",
            "value": "const request = String(<start.user_request> ?? '').trim();\nconst owner = String(<start.target_owner> ?? 'labadmin').trim();\nconst repo = String(<start.target_repo> ?? 'demo-fastapi').trim();\nconst baseBranch = String(<start.base_branch> ?? 'main').trim();\nconst artifactOwner = String(<start.artifact_owner> ?? 'labadmin').trim();\nconst artifactPackage = String(<start.artifact_package> ?? 'ai-demo-artifacts').trim();\nconst errors = [];\nif (request.length < 20) errors.push('Опишите задачу минимум двадцатью символами');\nif (request.length > 20000) errors.push('Задача превышает 20000 символов');\nif (!/^[A-Za-z0-9_.-]{1,100}$/.test(owner) || !/^[A-Za-z0-9_.-]{1,100}$/.test(repo)) errors.push('Некорректный owner/repo');\nif (!/^[A-Za-z0-9_.\\/-]{1,100}$/.test(baseBranch)) errors.push('Некорректная base branch');\nif (!/^[A-Za-z0-9_.-]{1,100}$/.test(artifactOwner) || !/^[A-Za-z0-9_.-]{1,100}$/.test(artifactPackage)) errors.push('Некорректный package owner/name');\nconst iso = new Date().toISOString();\nconst stamp = iso.slice(0,10).replace(/-/g,'') + '-' + iso.slice(11,19).replace(/:/g,'');\nconst suffix = Math.random().toString(36).slice(2,8).padEnd(6,'0');\nreturn {valid: errors.length === 0, errors, user_request: request, run_id: `run-${stamp}-${suffix}`, target: {owner, repo, base_branch: baseBranch}, artifact_owner: artifactOwner, artifact_package: artifactPackage};\n"
          },
          "language": {
            "id": "language",
            "type": "dropdown",
            "value": "javascript"
          }
        },
