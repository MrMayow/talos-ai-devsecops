      "1d5697e0-bf50-45e9-90f0-106022bfdb6b": {
        "id": "1d5697e0-bf50-45e9-90f0-106022bfdb6b",
        "type": "function",
        "name": "Normalize Decision",
        "position": {
          "x": 3950,
          "y": 80
        },
        "subBlocks": {
          "code": {
            "id": "code",
            "type": "code",
            "value": "const decision = String(<requirementsapproval.decision> ?? '').trim().toLowerCase();\nconst comments = String(<requirementsapproval.comments> ?? '').trim();\nconst valid = ['approve','reject'].includes(decision) && (decision !== 'reject' || comments.length >= 3);\nreturn {valid, decision, comments, error: valid ? '' : 'Допустимы approve или reject; для reject нужен комментарий'};\n"
          },
