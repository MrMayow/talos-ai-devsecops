# Environment backend and async worker SIM. Never commit real secret values.
GITEA_URL=http://gitea-service.example:3000
GITEA_TOKEN=REPLACE_WITH_ORCHESTRATOR_PAT
SIM_INTERNAL_URL=http://sim-service.example:3000
SIM_WORKFLOW01_ID=REPLACE_WITH_WORKFLOW_01_ID
SIM_WORKFLOW02_ID=REPLACE_WITH_WORKFLOW_02_ID
SIM_WORKFLOW03_ID=REPLACE_WITH_WORKFLOW_03_ID
SIM_WORKFLOW_API_KEY=REPLACE_WITH_WORKSPACE_SIM_KEY

# For self-hosted billing-disabled SIM, omit both timeout variables to disable
# plan timeouts. If your policy requires a finite limit, uncomment 7200.
# EXECUTION_TIMEOUT_FREE=7200
# EXECUTION_TIMEOUT_ASYNC_FREE=7200
